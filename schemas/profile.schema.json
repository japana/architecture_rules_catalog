{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "profileId",
    "ruleSetId",
    "schemaVersion",
    "status",
    "displayName",
    "description",
    "technology",
    "mappings"
  ],
  "properties": {
    "profileId": { "type": "string", "minLength": 1 },
    "ruleSetId": { "type": "string", "minLength": 1 },
    "schemaVersion": { "type": "string", "const": "ruleset-profile-v1" },
    "status": { "type": "string", "enum": ["draft", "review", "published", "deprecated"] },
    "displayName": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "extendsProfile": { "type": "string", "minLength": 1 },
    "technology": {
      "type": "object",
      "required": ["language"],
      "properties": {
        "language": { "type": "string", "minLength": 1 },
        "framework": { "type": "string", "minLength": 1 },
        "runtime": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "mappings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["ruleId", "detectionHints"],
        "properties": {
          "ruleId": { "type": "string", "pattern": "^AR-[0-9]{3}$" },
          "detectionHints": {
            "type": "object",
            "properties": {
              "forbiddenDependencyPatterns": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              },
              "indicativeAnnotations": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              },
              "indicativeBaseTypes": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              },
              "concreteComponentPatterns": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              },
              "recommendedTools": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              },
              "notes": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
