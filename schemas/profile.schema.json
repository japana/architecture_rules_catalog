{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "toolRequirement": {
      "type": "object",
      "required": ["type", "version"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "notes": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "detectionHints": {
      "type": "object",
      "properties": {
        "forbiddenDependencyPatterns": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "indicativeAnnotations": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "indicativeBaseTypes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "concreteComponentPatterns": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "recommendedTools": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "notes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "v1Profile": {
      "type": "object",
      "required": [
        "profileId",
        "ruleSetId",
        "schemaVersion",
        "status",
        "displayName",
        "description",
        "technology",
        "mappings"
      ],
      "properties": {
        "profileId": { "type": "string", "minLength": 1 },
        "ruleSetId": { "type": "string", "minLength": 1 },
        "schemaVersion": { "type": "string", "const": "ruleset-profile-v1" },
        "status": { "type": "string", "enum": ["draft", "review", "published", "deprecated"] },
        "displayName": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "extendsProfile": { "type": "string", "minLength": 1 },
        "technology": {
          "type": "object",
          "required": ["language"],
          "properties": {
            "language": { "type": "string", "minLength": 1 },
            "framework": { "type": "string", "minLength": 1 },
            "runtime": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "mappings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["ruleId", "detectionHints"],
            "properties": {
              "ruleId": { "type": "string", "pattern": "^AR-[0-9]{3}$" },
              "detectionHints": { "$ref": "#/$defs/detectionHints" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "v2Profile": {
      "type": "object",
      "required": [
        "profileId",
        "ruleSetId",
        "schemaVersion",
        "appliesTo",
        "ruleMappings"
      ],
      "properties": {
        "profileId": { "type": "string", "minLength": 1 },
        "ruleSetId": { "type": "string", "minLength": 1 },
        "schemaVersion": { "type": "string", "const": "ruleset-profile-v2" },
        "status": { "type": "string", "enum": ["draft", "review", "published", "deprecated"] },
        "displayName": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "extendsProfile": { "type": "string", "minLength": 1 },
        "appliesTo": {
          "type": "object",
          "required": ["languages"],
          "properties": {
            "languages": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            "frameworks": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            "architectureStyles": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            "runtimes": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            }
          },
          "additionalProperties": false
        },
        "toolchain": {
          "type": "object",
          "properties": {
            "required": {
              "type": "array",
              "items": { "$ref": "#/$defs/toolRequirement" }
            },
            "optional": {
              "type": "array",
              "items": { "$ref": "#/$defs/toolRequirement" }
            }
          },
          "additionalProperties": false
        },
        "ruleMappings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["ruleId", "verificationTemplates"],
            "properties": {
              "ruleId": { "type": "string", "pattern": "^AR-[0-9]{3}$" },
              "verificationTemplates": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["templateId", "coverage", "parameterBindings"],
                  "properties": {
                    "templateId": {
                      "type": "string",
                      "pattern": "^VT-AR-[0-9]{3}-[A-Z0-9-]+-[0-9]{3}$"
                    },
                    "coverage": {
                      "type": "string",
                      "enum": ["full", "partial", "heuristic", "supporting", "notAutomatable"]
                    },
                    "parameterBindings": {
                      "type": "object",
                      "minProperties": 1,
                      "additionalProperties": { "type": "string", "minLength": 1 }
                    },
                    "notes": {
                      "type": "array",
                      "items": { "type": "string", "minLength": 1 }
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/v1Profile" },
    { "$ref": "#/$defs/v2Profile" }
  ]
}
