{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "ruleSetId",
    "schemaVersion",
    "ruleSetVersion",
    "publisher",
    "license",
    "status",
    "rules"
  ],
  "properties": {
    "ruleSetId": { "type": "string", "minLength": 1 },
    "schemaVersion": { "type": "string", "const": "ruleset-catalog-v1" },
    "ruleSetVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "publisher": { "type": "string", "minLength": 1 },
    "license": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": ["draft", "review", "published", "deprecated", "invalid"]
    },
    "defaultLocale": { "type": "string", "pattern": "^[a-z]{2}(-[A-Z]{2})?$" },
    "availableLocales": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z]{2}(-[A-Z]{2})?$" }
    },
    "approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["maintainer", "approvedAt", "referenceType", "reference"],
        "properties": {
          "maintainer": { "type": "string", "minLength": 1 },
          "approvedAt": { "type": "string", "format": "date-time" },
          "referenceType": { "type": "string", "enum": ["commit", "review", "event"] },
          "reference": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "status",
          "type",
          "abstractionLevel",
          "strength",
          "decisionImpact",
          "detectability",
          "scope",
          "appliesTo",
          "source",
          "violationSignals",
          "relationships"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^AR-[0-9]{3}$" },
          "status": {
            "type": "string",
            "enum": ["draft", "active", "deprecated", "superseded"]
          },
          "type": {
            "type": "string",
            "enum": [
              "layering",
              "module-boundary",
              "dependency",
              "naming",
              "api",
              "persistence",
              "security",
              "testing",
              "build",
              "operations",
              "governance"
            ]
          },
          "abstractionLevel": {
            "type": "string",
            "enum": ["principle", "practice", "technology-profile"]
          },
          "strength": {
            "type": "string",
            "enum": ["must", "should", "may"]
          },
          "decisionImpact": {
            "type": "string",
            "enum": ["blocking", "warning", "advisory"]
          },
          "detectability": {
            "type": "string",
            "enum": ["manual", "ai-assisted", "static-analysis", "process", "runtime"]
          },
          "scope": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["dimension", "values"],
              "properties": {
                "dimension": {
                  "type": "string",
                  "enum": ["architectureStyle", "artifactType", "criticality"]
                },
                "values": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": { "type": "string", "minLength": 1 }
                }
              },
              "additionalProperties": false
            }
          },
          "appliesTo": {
            "type": "object",
            "required": ["artifactTypes", "architectureElements"],
            "properties": {
              "artifactTypes": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "enum": [
                    "source-code",
                    "module-structure",
                    "architecture-design",
                    "api-contract",
                    "configuration",
                    "build-pipeline",
                    "runtime-operation",
                    "documentation",
                    "test-artifact"
                  ]
                }
              },
              "architectureElements": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "enum": [
                    "domain",
                    "application",
                    "adapter",
                    "infrastructure",
                    "interface",
                    "module",
                    "service",
                    "data-store",
                    "external-system",
                    "deployment"
                  ]
                }
              }
            },
            "additionalProperties": false
          },
          "source": {
            "type": "object",
            "required": ["type", "name", "reference"],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "architecture-principle",
                  "engineering-practice",
                  "security-principle",
                  "governance-guideline"
                ]
              },
              "name": { "type": "string", "minLength": 1 },
              "reference": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          },
          "violationSignals": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "relationships": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["target", "type"],
              "properties": {
                "target": { "type": "string", "minLength": 1 },
                "type": {
                  "type": "string",
                  "enum": [
                    "supports",
                    "refines",
                    "dependsOn",
                    "conflictsWith",
                    "supersedes",
                    "duplicates",
                    "relatedTo"
                  ]
                },
                "rationale": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
