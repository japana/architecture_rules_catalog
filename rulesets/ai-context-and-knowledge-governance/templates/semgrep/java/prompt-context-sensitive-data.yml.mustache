rules:
  - id: ai-context-sensitive-data-assembly
    message: Sensitive data appears to be assembled into AI context without an allowed sanitizer.
    severity: WARNING
    languages:
      - java
    patterns:
      - pattern-either:
          - pattern: |
              $BUILDER.add($VALUE)
          - pattern: |
              $BUILDER.append($VALUE)
          - pattern: |
              $BUILDER.put($KEY, $VALUE)
{{#sanitizerMethodPatternsList}}
      - pattern-not: |
          $BUILDER.add({{.}})
      - pattern-not: |
          $BUILDER.append({{.}})
      - pattern-not: |
          $BUILDER.put($KEY, {{.}})
{{/sanitizerMethodPatternsList}}
      - metavariable-regex:
          metavariable: $BUILDER
          regex: "{{contextBuilderTypeRegex}}"
      - metavariable-regex:
          metavariable: $VALUE
          regex: "{{sensitiveFieldRegex}}"
